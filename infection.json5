{
  "$schema" : "vendor/infection/infection/resources/schema.json",
  "source"  : {
    "directories": [
      "src"
    ]
  },
  "logs"    : {
    "text": "build/infection.txt",
    "html": "build/infection.html"
  },
  "mutators": {
    "@default"     : true,
    "TrueValue"    : {
      "ignore": [
        "Engine\\Container\\Container::lazy"
      ]
    },
    "FalseValue"   : {
      "ignore": [
        "Engine\\Container\\Container::resolve"
      ]
    },
    "Break_"       : {
      "ignore": [
        "Engine\\Container\\Container::collectDependencies::388"
      ]
    },
    "Coalesce"     : {
      "ignore": [
        "Engine\\Container\\Resolvers\\GenericResolver::resolve::56",
      ]
    },
    "IfNegation"   : {
      "ignore": [
        "Engine\\Container\\Container::invokeClassMethod::345"
      ]
    },
    "ReturnRemoval": {
      "ignore": [
        "Engine\\Container\\Container::invokeClassMethod::346"
      ]
    }
  }
}
